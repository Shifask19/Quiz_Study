# SnapStudy Environment Configuration
# Copy this file to .env and fill in your values

# App
APP_NAME=SnapStudy
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=sqlite:///./data/snapstudy.db

# Storage
UPLOAD_DIR=./data/uploads
VECTOR_DB_DIR=./data/vector_db
MAX_UPLOAD_SIZE_MB=50

# AI Model Configuration
# Options: "local_llm", "onnx", "qualcomm_ai_hub", "mock"
AI_PROVIDER=mock

# Local LLM (e.g., llama.cpp, ollama)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_TIMEOUT=120

# ONNX Model paths (optional)
ONNX_LLM_PATH=./models/llm.onnx
ONNX_EMBED_PATH=./models/embeddings.onnx

# Qualcomm AI Hub (optional - requires qai_hub SDK)
QAI_HUB_API_TOKEN=
QAI_HUB_MODEL_ID=
QAI_HUB_DEVICE=snapdragon-x-elite

# Embedding Model
# Options: "sentence_transformers", "onnx", "qualcomm_ai_hub", "mock"
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5

# Voice (optional)
VOICE_ENABLED=false
TTS_MODEL=local
STT_MODEL=local

# Benchmark
BENCHMARK_ITERATIONS=3
